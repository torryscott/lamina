e structure marked by the \"X\". *This is White Matter", "TertiaryAttribute": null, "Payload": {"QuestionText": "Identify the structure marked by the \"X\".\n<div>*This is <b>White Matter</b></div>", "DefaultChoices": false, "QuestionType": "TE", "Selector": "SL", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Identify the structure marked by the \"X\". *This is White Matter", "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [{"Grades": {"SC_8hUs9P4u02sGMVT": "1.25"}, "TextEntry": "Septum Pellucidum"}], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "DataVisibility": {"Private": false, "Hidden": false}, "QuestionText_Unsafe": "Identify the structure marked by the \"X\".\n<div>*This is <b>White Matter</b></div>", "DataExportTag": "Q434", "QuestionID": "QID434", "DisplayLogic": {"0": {"0": {"LogicType": "EmbeddedField", "LeftOperand": "inc_mid_lat_brachium", "Operator": "NotEqualTo", "RightOperand": "0", "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span> <span class=\"LeftOpDesc\">inc_mid_lat_brachium</span> <span class=\"OpDesc\">Is Not Equal to</span> <span class=\"RightOpDesc\">0</span>"}, "Type": "If"}, "Type": "BooleanExpression", "inPage": false}}}, {"SurveyID": "SV_e5qxdjKxDQL1V8q", "Element": "SQ", "PrimaryAttribute": "QID435", "SecondaryAttribute": "Timing", "TertiaryAttribute": null, "Payload": {"QuestionText": "Timing", "DefaultChoices": false, "QuestionType": "Timing", "Selector": "D", "Configuration": {"QuestionDescriptionOption": "UseText", "MinSeconds": "0", "MaxSeconds": 60, "ShowTimer": true, "CountDirection": "Decrementing", "Seconds": 60}, "QuestionDescription": "Timing", "Choices": {"1": {"Display": "First Click"}, "2": {"Display": "Last Click"}, "3": {"Display": "Page Submit"}, "4": {"Display": "Click Count"}}, "GradingData": [], "Language": [], "NextChoiceId": 944, "NextAns