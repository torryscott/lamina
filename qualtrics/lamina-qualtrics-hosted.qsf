span class=\"ConjDesc\">If</span> <span class=\"LeftOpDesc\">inc_vent_ventromedian_fissure</span> <span class=\"OpDesc\">Is Not Equal to</span> <span class=\"RightOpDesc\">0</span>"}, "Type": "If"}, "Type": "BooleanExpression", "inPage": false}}}, {"SurveyID": "SV_e5qxdjKxDQL1V8q", "Element": "SQ", "PrimaryAttribute": "QID18", "SecondaryAttribute": "Identify the structure marked by the \"X\". *This is a thin piece of tissue. \u00a0", "TertiaryAttribute": null, "Payload": {"QuestionText": "Identify the structure marked by the &quot;X&quot;.\n<div>*This is a <strong>thin piece of tissue</strong>. &nbsp;</div>", "DefaultChoices": false, "QuestionType": "TE", "Selector": "SL", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Identify the structure marked by the \"X\". *This is a thin piece of tissue. \u00a0", "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [{"Grades": {"SC_8hUs9P4u02sGMVT": "1.25"}, "TextEntry": "Septum Pellucidum"}], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "DataVisibility": {"Private": false, "Hidden": false}, "QuestionText_Unsafe": "Identify the structure marked by the \"X\".<div>*This is Gray Matter</div>", "DataExportTag": "Cor - 5 Ans", "QuestionID": "QID18", "DisplayLogic": {"0": {"0": {"LogicType": "EmbeddedField", "LeftOperand": "inc_cor_septum_pellucidum", "Operator": "NotEqualTo", "RightOperand": "0", "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span> <span class=\"LeftOpDesc\">inc_cor_septum_pellucidum</span> <span class=\"OpDesc\">Is Not Equal to</span> <span class=\"RightOpDesc\">0</span>"}, "Type": "If"}, "Type": "BooleanExpression", "inPage": false}}}, {"SurveyID": "SV_e5qxdjKxDQL1V8q", "Element": "SQ", "PrimaryAttribute": "QID183", "SecondaryAttribute": "For each question, I have indicated whether the brain area/feature is gray matter, white matter,...", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h1><span style=\"font-size: medium;\">For each question, I have indicated whether the brain area/feature is gray matter, white matter, a cavity, or a groove. I&#39;ve provided below a more detailed explanation of these designations.</span></h1>\n\n<div>\n<ul>\n\t<li><span style=\"font-size:16px;\"><span style=\"font-family:Calibri, sans-serif\"><span style=\"caret-color:#000000\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-variant-caps:normal\"><span style=\"font-weight:normal\"><span style=\"letter-spacing:normal\"><span style=\"text-transform:none\"><span style=\"white-space:normal\"><span style=\"word-spacing:0px\"><span style=\"text-decoration:none\"><b><i>Gray matter</i></b><i>:&nbsp;</i>A group of cell bodies in the brain. May include one of the following terms: nucleus, body, gyrus.&nbsp;&nbsp;</span></span></span></span></span></span></span></span></span></span></span></span></li>\n\t<li><span style=\"font-size:16px;\"><span style=\"font-family:Calibri, sans-serif\"><span style=\"caret-color:#000000\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-variant-caps:normal\"><span style=\"font-weight:normal\"><span style=\"letter-spacing:normal\"><span style=\"text-transform:none\"><span style=\"white-space:normal\"><span style=\"word-spacing:0px\"><span style=\"text-decoration:none\"><b><i>White matter</i></b><i>:&nbsp;</i>A fiber tract (group of axons).&nbsp;May include one of the following terms:&nbsp;&nbsp;tract, nerve, fasciculus (&ldquo;little bundle&rdquo;), peduncle, capsule, or commissure.&nbsp;&nbsp;</span></span></span></span></span></span></span></span></span></span></span></span></li>\n\t<li><span style=\"font-size:16px;\"><span style=\"font-family:Calibri, sans-serif\"><span style=\"caret-color:#000000\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-variant-caps:normal\"><span style=\"font-weight:normal\"><span style=\"letter-spacing:normal\"><span style=\"text-transform:none\"><span style=\"white-space:normal\"><span style=\"word-spacing:0px\"><span style=\"text-decoration:none\"><b><i>Cavities</i></b><i>:&nbsp;</i>Cerebrospinal fluid (CSF)-filled chambers in the brain may be called ventricles, aqueducts, or cisterns.</span></span></span></span></span></span></span></span></span></span></span></span></li>\n\t<li><span style=\"font-size:16px;\"><span style=\"font-family:Calibri, sans-serif\"><span style=\"caret-color:#000000\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-variant-caps:normal\"><span style=\"font-weight:normal\"><span style=\"letter-spacing:normal\"><span style=\"text-transform:none\"><span style=\"white-space:normal\"><span style=\"word-spacing:0px\"><span style=\"text-decoration:none\"><b><i>Grooves</i></b><i>:</i>&nbsp;Grooves may be called sulci (singular: sulcus) or fissures.&nbsp;</span></span></span></span></span></span></span></span></span></span></span></span></li>\n</ul>\n<span style=\"font-size:16px;\"><span style=\"font-family:Calibri, sans-serif\"><span style=\"caret-color:#000000\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-variant-caps:normal\"><span style=\"font-weight:normal\"><span style=\"letter-spacing:normal\"><span style=\"text-transform:none\"><span style=\"white-space:normal\"><span style=\"word-spacing:0px\"><span style=\"text-decoration:none\">You will have <u>1 minute</u> to answer each labeling question. After typing your answer, be sure to click on the right-facing arrow on the bottom right of the page to submit your answer and to see whether or not you were correct.</span></span></span></span></span></span></span></span></span></span></span></span></div>", "DefaultChoices": false, "DataExportTag": "Intro Info", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "For each question, I have indicated whether the brain area/feature is gray matter, white matter,...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID183", "DataVisibility": {"Private": false, "Hidden": false}}}, {"SurveyID": "SV_e5qxdjKxDQL1V8q", "Element": "SQ", "PrimaryAttribute": "QID185", "SecondaryAttribute": "Please type your name in the box below. ", "TertiaryAttribute": null, "Payload": {"QuestionText": "Please type your name in the box below.&nbsp;", "DefaultChoices": false, "DataExportTag": "Name", "QuestionID": "QID185", "QuestionType": "TE", "Selector": "SL", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Please type your name in the box below. ", "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}}}, {"SurveyID": "SV_e5qxdjKxDQL1V8q", "Element": "SQ", "PrimaryAttribute": "QID187", "SecondaryAttribute": "Cor 1", "TertiaryAttribute": null, "Payload": {"QuestionText": "Cor   1", "DefaultChoices": false, "QuestionType": "DB", "Selector": "GRB", "SubSelector": "WOTXB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Cor 1", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "Graphics": "IM_ahMIHfWaVEkjAmF", "GraphicsDescription": "Cor   1", "DataVisibility": {"Private": false, "Hidden": false}, "QuestionText_Unsafe": "Cor   1", "DataExportTag": "Q187", "QuestionID": "QID187", "DisplayLogic": {"0": {"0": {"LogicType": "EmbeddedField", "LeftOperand": "inc_cor_internal_capsule", "Operator": "NotEqualTo", "RightOperand": "0", "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span> <span class=\"LeftOpDesc\">inc_cor_in